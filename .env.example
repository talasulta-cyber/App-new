# Railway PostgreSQL reference variable for the new sync project only
SYNC_DATABASE_URL=${{Postgres.DATABASE_URL}}

# Generate unique random values and store them in Railway Variables
SYNC_SESSION_SECRET=replace-with-a-long-random-secret
SYNC_ADMIN_SETUP_TOKEN=replace-with-a-separate-admin-token

# Railway injects PORT automatically; this fallback is for local use
PORT=3000
